# Copy this file to .env.local (gitignored) and fill in real values.
# main.py loads .env then .env.local (overriding) at startup -- see its
# own docstring for why this only happens on `python main.py`, not on import.

# --- Required: LLM provider for @planner (llm.py) ---------------------------
# Any "<provider>:<model>" string langchain.chat_models.init_chat_model()
# accepts. See README.md's "실행" section for verified working models.
AUTOCIM_PLANNER_MODEL=anthropic:claude-sonnet-4-5-20250929

# Matching provider API key -- only the one for whichever provider you set
# above is actually required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# --- Optional: LLM call operations (llm.py) ----------------------------------
# AUTOCIM_LLM_MAX_RETRIES=3
# AUTOCIM_LLM_BASE_DELAY_SECONDS=1.0
# AUTOCIM_LLM_MAX_DELAY_SECONDS=20.0
# AUTOCIM_LLM_COST_PER_1K_INPUT_USD=
# AUTOCIM_LLM_COST_PER_1K_OUTPUT_USD=
# AUTOCIM_LLM_MAX_TOTAL_COST_USD=
# AUTOCIM_LLM_MAX_TOTAL_TOKENS=

# --- Optional: QAT dataset scope / device (tools/qat.py) ---------------------
# AUTOCIM_QAT_TRAIN_SIZE=512
# AUTOCIM_QAT_VAL_SIZE=128
# AUTOCIM_QAT_TEST_SIZE=1000
# AUTOCIM_QAT_BATCH_SIZE=32
# AUTOCIM_QAT_SEED=0
# AUTOCIM_QAT_DEVICE=

# --- Optional: structured logging (observability.py) -------------------------
# AUTOCIM_LOG_DIR=
